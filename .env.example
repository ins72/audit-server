# NODE_ENV=production makes a missing SESSION_SECRET fatal (the Dockerfile sets it). Leave unset for local development.

# --- Required in production -------------------------------------------------
# Long random string used to sign session cookies (32+ chars). Example: openssl rand -hex 32
SESSION_SECRET=
# Bearer token for GET /admin/sessions and /admin/billing (leave empty to disable the admin API)
ADMIN_TOKEN=
# Set to true when served over HTTPS (Secure cookies + HSTS)
COOKIE_SECURE=true
# Public https origin of your site, no trailing slash. Needed for Stripe redirects and enables the CSRF origin check.
PUBLIC_URL=https://your-domain.example
# Number of reverse proxies in front of Node (nginx = 1) so rate limits see real client IPs
TRUST_PROXY=1

# --- Paywall (optional; off by default: login is still required) -------------
PAYWALL_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Extra people the owner may invite to share their plan
INVITE_SEATS=2
# Collect billing address and let Stripe Tax add VAT/sales tax (enable Stripe Tax in the dashboard first)
# STRIPE_AUTOMATIC_TAX=true
# Optional: several plans instead of STRIPE_PRICE_ID/INVITE_SEATS. JSON array; seats = people the owner may invite (0-50).
# PLANS=[{"id":"solo","name":"Solo","priceId":"price_aaa","seats":0},{"id":"family","name":"Family","priceId":"price_bbb","seats":4,"description":"You plus 4"}]
# (PLANS only seeds the plan store the first time; afterwards plans are managed in the operator dashboard and kept in PLANS_FILE=data/plans.json)
# Days of access kept after a failed renewal payment while Stripe retries the card
PAST_DUE_GRACE_DAYS=3

# Optional invite emails via Resend (all three needed: PUBLIC_URL above, plus these)
RESEND_API_KEY=
MAIL_FROM="Your App <invites@your-domain.example>"
# Require invited people to confirm their address via an emailed one-time link before the invite grants access
# (needs the three settings above). Recommended: Stremio may not verify emails.
# INVITE_CONFIRM=true
# Unused invitations expire after this many days (0 = never)
# INVITE_EXPIRY_DAYS=30
# Max browsers signed in at once per account; a newer login signs out the least recently used (0 = unlimited)
# MAX_DEVICES=3

# --- Optional ----------------------------------------------------------------
# (for `pnpm start` development use PORT=8081: the dev server already owns 8080)
PORT=8080
# Audit trail (JSON lines) of invites, grants, bans and erasures
# AUDIT_FILE=./data/audit.log
# Where data is stored (defaults to ./data/users.json and ./data/billing.json)
USERS_FILE=
BILLING_FILE=
STREMIO_API_URL=https://api.strem.io
# Use our own account service instead of api.strem.io (see docs/ACCOUNTS_API.md). Sign-up/closed and starting add-ons are set in the operator panel.
# OWN_ACCOUNTS=true
# ACCOUNTS_FILE=./data/accounts.db

# Usage statistics (logins, daily active, player-reported watch time and titles). Set to false to collect nothing.
# WATCH_STATS=true
# STATS_FILE=./data/stats.json

# Shown to blocked users so they know whom to contact
# SUPPORT_EMAIL=support@example.com   (default only; the operator can change it live in the dashboard Settings)
# SETTINGS_FILE=data/settings.json     (operator-edited settings: name, tagline, support email, links)

# Testing only: point the Stripe SDK at stripe-mock or a test double (never set in production)
# STRIPE_MOCK_URL=http://127.0.0.1:12111

# Trakt (optional, needs OWN_ACCOUNTS=true): create an app at trakt.tv/oauth/applications with the redirect address PUBLIC_URL/trakt/callback
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
